    "如何修复安装失败的问题？" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to fix the installation failure problem?"
          }
        },
        "zh-Hans" : {
